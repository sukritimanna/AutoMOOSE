{
  "name": "AutoMOOSE grain-growth evaluation set v1 (production length, end_time=4000)",
  "version": "1.0-prod",
  "n_tasks": 25,
  "physics": "grain_growth",
  "criteria_definitions": {
    "G1_input_valid": "Agent produced a parseable MOOSE input (input_ok == true, line_count > 50).",
    "G2_completed": "MOOSE ran to completion without solver divergence (status == 'done').",
    "G3_coarsened": "Microstructure coarsened: grains_final < grains_initial.",
    "G4_kinetics": "Parabolic grain-growth kinetics recovered: parabolic_R2 >= 0.90.",
    "G5_positive_rate": "Physically valid rate constant: parabolic_k > 0."
  },
  "success_rule": "success == (G1 and G2 and G3 and G4 and G5)",
  "regimes": [
    "3d_stress",
    "core",
    "formulation",
    "high_T_stress",
    "resolution",
    "resolution_stress",
    "robustness"
  ],
  "design_notes": "Production-length evaluation: 25 tasks at end_time=4000 (vs 500 demonstration), so grains coarsen substantially and Burke-Turnbull parabolic kinetics develop, enabling the G4 kinetics gate. Inputs regenerated with the corrected generator (op_num scaled by dim/grain-count; nonlinear_preconditioning removed). Physics breadth spans temperature (450-700 K), grain count, resolution, formulation, seed, and dimension.",
