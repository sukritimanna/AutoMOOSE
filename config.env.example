# AutoMOOSE environment configuration
# Copy this file to config.env and fill in your values
# NEVER commit config.env to git

# Path to your compiled MOOSE executable
MOOSE_EXEC=/path/to/moose/phase_field-opt

# Directory for simulation run outputs (relative to backend/)
RUNS_DIR=../runs

# Backend API settings
API_HOST=0.0.0.0
API_PORT=8000

# MCP server settings
MCP_HOST=0.0.0.0
MCP_PORT=8001
